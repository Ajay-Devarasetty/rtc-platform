# Builds both frontends as static bundles. They are served by Caddy from the
# same origin as the API, so their relative URLs resolve without any rewriting.
FROM node:22-alpine AS builder
WORKDIR /app

ARG VITE_DEMO_APP_SECRET=demo-secret
ENV VITE_DEMO_APP_SECRET=$VITE_DEMO_APP_SECRET

COPY package.json package-lock.json ./
COPY packages/protocol/package.json packages/protocol/
COPY packages/sdk/package.json packages/sdk/
COPY packages/demo/package.json packages/demo/
COPY packages/dashboard/package.json packages/dashboard/
RUN npm ci

COPY packages/protocol packages/protocol
COPY packages/sdk packages/sdk
COPY packages/demo packages/demo
COPY packages/dashboard packages/dashboard

RUN npm run build -w @rtc/protocol
# The demo aliases @rtc/sdk to source, so it needs no prebuilt SDK bundle.
RUN npm run build -w @rtc/demo
RUN npm run build -w @rtc/dashboard

# Static output only — Caddy serves these via a compose volume at /out.
# Built assets live under /staging so a mounted /out volume cannot hide them.
FROM alpine:3.20
RUN mkdir -p /staging/demo /staging/dashboard
COPY --from=builder /app/packages/demo/dist /staging/demo
COPY --from=builder /app/packages/dashboard/dist /staging/dashboard
CMD ["sh", "-c", "rm -rf /out/demo /out/dashboard && cp -r /staging/demo /out/demo && cp -r /staging/dashboard /out/dashboard && echo frontends staged"]
