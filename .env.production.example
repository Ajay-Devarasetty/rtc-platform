# Copy to .env.production on the VM and fill in. Never commit the filled copy.
#
#   cp .env.production.example .env.production
#
# The signaling server refuses to boot in production if JWT_SECRET or
# ADMIN_API_KEY are left at dev defaults, and media-sfu refuses to boot if
# ANNOUNCED_IP is still 127.0.0.1 (see packages/*/src/env.ts).

# --- Public addressing -------------------------------------------------------
# Domain pointing at the VM. Required: Let's Encrypt cannot issue for a bare IP,
# and browsers block camera/mic without TLS. A free DuckDNS subdomain works.
DOMAIN=your-app.duckdns.org
TLS_EMAIL=you@example.com

# The VM's external IP. Browsers send WebRTC media straight here, so this must
# be the public address, never an internal 10.x one.
PUBLIC_IP=203.0.113.10

# --- Secrets — generate fresh, do not reuse the dev values -------------------
# openssl rand -hex 32
JWT_SECRET=
ADMIN_API_KEY=

POSTGRES_USER=rtc
POSTGRES_DB=rtc
# openssl rand -hex 24
POSTGRES_PASSWORD=

TURN_USERNAME=rtc
# openssl rand -hex 24
TURN_PASSWORD=

# --- Optional ----------------------------------------------------------------
# Without this, transcripts and summaries return placeholder text.
OPENAI_API_KEY=

# Leave blank to run with no demo app — the safe default for a public
# deployment, since the dev credentials are published in the README. Set it to
# a generated value (openssl rand -hex 24) only if you want a working demo app,
# and hand that secret out deliberately.
DEMO_APP_SECRET=

# RTMP ingest (host network in prod — rtmp-ingest listens on 1935/8080).
# HLS_PUBLIC_URL is what clients use to play the stream.
# RTMP_INGEST_URL is what media-sfu ffmpeg pushes to (localhost on the VM).
RTMP_INGEST_URL=rtmp://127.0.0.1/live
HLS_PUBLIC_URL=https://your-app.duckdns.org/hls

# 32-byte encryption key for portal-managed Firebase/APNs credentials (64 hex characters).
# Generate once with: openssl rand -hex 32. Keep backed up; do not rotate without re-encrypting stored credentials.
PUSH_CREDENTIALS_KEY=
